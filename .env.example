# ==============================================================================
# PyQGIS FastAPI Bridge - Environment Configuration
# ==============================================================================

# Server Network Binding
# 0.0.0.0 binds to all network interfaces, allowing team members on the same
# Tailscale mesh network (tailnet) to connect without requiring updates from GitHub.
HOST=0.0.0.0
PORT=8000

# Client / Teammate Connection Endpoint
# Set this to your teammate's Tailscale IP address or MagicDNS hostname.
# Examples:
#   Tailscale IP:       http://100.85.12.34:8000/api/v1
#   Tailscale MagicDNS: http://gis-station.tailscale.net:8000/api/v1
#   Local loopback:     http://127.0.0.1:8000/api/v1
PYQGIS_BRIDGE_API_URL=http://127.0.0.1:8000/api/v1

# Public Geospatial & Weather APIs (Optional Overrides)
GUGIK_ULDK_URL=https://uldk.gugik.gov.pl/
IMGW_SYNOP_URL=https://danepubliczne.imgw.pl/api/data/synop
IMGW_WARNINGS_URL=https://danepubliczne.imgw.pl/api/data/warnings/meteo
